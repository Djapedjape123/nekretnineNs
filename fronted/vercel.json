{
  "redirects": [
    {
      "source": "/nekretnine/prodaja",
      "destination": "/prodaja",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/single/:id",
      "destination": "https://api.serbesnekretnine.com/single/:id"
    },
    {
      "source": "/oglas/:id",
      "destination": "https://api.serbesnekretnine.com/oglas/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}