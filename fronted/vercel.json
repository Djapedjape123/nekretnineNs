{
  "redirects": [
    {
      "source": "/nekretnine/prodaja",
      "destination": "/prodaja",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/single/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|whatsapp|Viber|viber|Skype|skype|Twitterbot|twitterbot|LinkedInBot|linkedinbot|TelegramBot|telegrambot|Discordbot|discordbot).*"
        }
      ],
      "destination": "https://api.serbesnekretnine.com/single/:id"
    },
    {
      "source": "/oglas/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|whatsapp|Viber|viber|Skype|skype|Twitterbot|twitterbot|LinkedInBot|linkedinbot|TelegramBot|telegrambot|Discordbot|discordbot).*"
        }
      ],
      "destination": "https://api.serbesnekretnine.com/oglas/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}